{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "after 8am and before 10pm every weekday"
  ],
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "schedule:monthly"
    ],
    "automerge": false
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "matchDatasources": [
        "terraform-provider"
      ],
      "matchPackageNames": [
        "goauthentik/authentik"
      ],
      "groupName": "authentik provider"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/validate\\.ya?ml$/"],
      "matchStrings": ["CONFTEST_VERSION: v?(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "open-policy-agent/conftest",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/docs\\.ya?ml$/"],
      "matchStrings": ["quay\\.io/terraform-docs/terraform-docs:(?<currentValue>[0-9.]+-amd64)"],
      "depNameTemplate": "quay.io/terraform-docs/terraform-docs",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
